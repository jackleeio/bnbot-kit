{
  "manifest_version": 3,
  "name": "BNBot",
  "version": "0.12.3",
  "description": "Control Chrome with BNBot.",
  "icons": {
    "16": "assets/images/icon-16.png",
    "48": "assets/images/icon-48.png",
    "128": "assets/images/icon-128.png"
  },
  "permissions": [
    "storage",
    "offscreen",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "*://api.bnbot.ai/*",
    "*://mp.weixin.qq.com/*"
  ],
  "background": {
    "service_worker": "background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BNBot",
    "default_icon": {
      "16": "assets/images/icon-16.png",
      "48": "assets/images/icon-48.png",
      "128": "assets/images/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*"
      ],
      "js": [
        "index.tsx"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "wechat-scraper-inject.js",
        "timeline-interceptor.js",
        "tweet-interceptor.js",
        "offscreen.html"
      ],
      "matches": [
        "*://x.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' wss://api.bnbot.ai https://api.bnbot.ai https://mp.weixin.qq.com http://mp.weixin.qq.com ws://localhost:* http://localhost:* blob: data:; img-src 'self' https://abs.twimg.com https://pbs.twimg.com blob: data:; media-src 'self' blob: data:; worker-src 'self';"
  }
}
