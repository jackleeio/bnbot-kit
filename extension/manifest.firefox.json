{
  "manifest_version": 3,
  "name": "BNBot",
  "version": "0.12.5",
  "description": "Control Chrome with BNBot.",
  "icons": {
    "16": "assets/images/icon-16.png",
    "48": "assets/images/icon-48.png",
    "128": "assets/images/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://api.bnbot.ai/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "wechat-scraper-inject.js",
        "timeline-interceptor.js",
        "tweet-interceptor.js"
      ],
      "matches": [
        "*://x.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' wss://api.bnbot.ai https://api.bnbot.ai ws://localhost:* ws://127.0.0.1:* http://localhost:* http://127.0.0.1:* blob: data:; img-src 'self' https://abs.twimg.com https://pbs.twimg.com blob: data:; media-src 'self' blob: data:; worker-src 'self';"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bnbot@bnbot.ai",
      "strict_min_version": "109.0"
    }
  }
}
